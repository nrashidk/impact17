# PostgreSQL connection string (Neon or Supabase managed)
DATABASE_URL=

# NextAuth.js — generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth provider — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic Claude API — for photo verification and content moderation.
# Required (also set on Vercel). ANTHROPIC_MODEL is optional; defaults to
# claude-sonnet-4-6.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Resend — transactional email
RESEND_API_KEY=

# Admin seed trigger — protects POST /api/admin/seed.
# Generate a long random value: `openssl rand -base64 32`. Required to run
# the catalogue seed against a deployed database.
ADMIN_SEED_SECRET=

# Vercel Blob — submission photo storage. Auto-provisioned by Vercel when a
# Blob store is linked to the project (Storage tab → Create/Connect Blob
# store). Locally, pull it with `vercel env pull` after linking.
BLOB_READ_WRITE_TOKEN=
