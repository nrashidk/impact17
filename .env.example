# PostgreSQL connection string (Neon or Supabase managed)
DATABASE_URL=

# NextAuth.js — generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth provider — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic Claude API — for photo verification and content moderation
ANTHROPIC_API_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Admin seed trigger — protects POST /api/admin/seed.
# Generate a long random value: `openssl rand -base64 32`. Required to run
# the catalogue seed against a deployed database.
ADMIN_SEED_SECRET=
